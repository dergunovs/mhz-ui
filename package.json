{
  "name": "mhz-ui-helpers",
  "description": "mhz-ui and mhz-helpers monorepo",
  "version": "1.4.42",
  "author": "Alexandr Dergunov <dergunovs@mail.ru> (https://github.com/dergunovs)",
  "license": "MIT",
  "homepage": "https://ui.9000mhz.ru",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dergunovs/mhz-ui"
  },
  "scripts": {
    "lint": "turbo run lint",
    "ts": "turbo run ts",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "pub": "turbo run build && changeset publish"
  },
  "dependencies": {
    "@changesets/cli": "3.0.3",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.7"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "npm": ">=11.7.0",
    "node": ">=26.5.0"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "typescript",
    "vue",
    "vite"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true
  }
}
