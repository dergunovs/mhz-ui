{
  "name": "mhz-ui",
  "description": "Mhz ui kit",
  "version": "1.4.45",
  "author": "Alexandr Dergunov <dergunovs@mail.ru> (https://github.com/dergunovs)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dergunovs/mhz-ui",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "vite build && storybook build",
    "dev": "storybook dev -p 6006 --no-open",
    "lint": "eslint **/*.{js,ts,vue} && stylelint src/**/*.{scss,vue}",
    "ts": "vue-tsc --noEmit",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:cov": "NODE_OPTIONS='--no-experimental-webstorage' vitest run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "chart.js": "4.6.1",
    "mhz-helpers": "*",
    "perfect-debounce": "2.1.0",
    "vue": "3.6.0-rc.14",
    "vue-chartjs": "5.3.4",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/vue3": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "sass-embedded": "1.108.0",
    "storybook": "10.6.6",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.10.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-order": "8.1.3",
    "stylelint-prettier": "5.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-static-copy": "4.1.1",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-linters-config": "0.5.10",
    "vue-tsc": "3.3.14"
  },
  "peerDependencies": {
    "vue": "3.6.0-rc.14",
    "vue-router": "5.4.0"
  },
  "engines": {
    "npm": ">=11.20.0",
    "node": ">=26.12.1"
  }
}
